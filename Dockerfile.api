# API image (Ahmed, A10). Static Go binary on distroless: no shell, runs as non-root, ~20 MB.
# Build:  docker build -f Dockerfile.api -t dwts-api .
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/api ./cmd/api

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/api /app/api
# Dev data so the API is useful before the database exists (A2). Replaced by the real DB later.
COPY testdata/stats_fixture.json testdata/incidents_fixture.json /app/testdata/
COPY testdata/stories /app/testdata/stories
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/app/api"]
CMD ["serve"]
