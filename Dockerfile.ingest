# Dockerfile.ingest (same pattern as Dockerfile.api, building ./cmd/ingest).
# go.mod needs Go >= 1.26, hence the 1.27 builder.
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ingest ./cmd/ingest
FROM gcr.io/distroless/static-debian12
WORKDIR /app
COPY --from=build /out/ingest /app/ingest
ENTRYPOINT ["/app/ingest"]
