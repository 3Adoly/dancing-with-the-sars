# Copy to .env.local to override .env.development.
# true = in-browser mock only (offline). Default: real backend + mock fallback for 501 endpoints.
VITE_USE_MOCKS=false
# false = never fall back to the mock; show backend errors instead.
VITE_MOCK_FALLBACK=true
# Backend origin for production builds. Empty in dev = use the Vite proxy (VITE_PROXY_TARGET).
VITE_API_BASE=
# Where the dev proxy sends /api, /media and /healthz.
VITE_PROXY_TARGET=http://164.92.235.173:8090
