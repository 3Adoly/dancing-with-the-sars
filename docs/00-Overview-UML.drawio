y=0;" edge="1" parent="1" source="c14" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e42" value="bulk load + aggregates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#000000;fontSize=11;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c29" target="c28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1310" y="740"/></Array></mxGeometry></mxCell><mxCell id="e43" value="download (HTTP)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#000000;fontSize=11;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c29" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e44" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#000000;fontSize=11;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e45" value="processed offline (Python)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#000000;fontSize=11;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c34" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e46" value="served as /media/stories" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#000000;fontSize=11;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="640"/><mxPoint x="870" y="640"/><mxPoint x="870" y="423"/></Array></mxGeometry></mxCell><mxCell id="c47" value="&lt;b&gt;Typical visit&lt;/b&gt;&lt;br&gt;1. Open the website → world map loads&lt;br&gt;2. Pick incident types (e.g. Floods) and years (e.g. 1950–2000) → countries colored by number of incidents&lt;br&gt;3. Search an incident or zoom in and click one → details&lt;br&gt;4. See radar (SAR) before/after images of that place&lt;br&gt;5. Open a Story → NISAR change-detection map, swipe slider, time animation, 'how to read' text&lt;br&gt;6. &lt;i&gt;(optional)&lt;/i&gt; Ask the AI chat a question about the data" style="whiteSpace=wrap;html=1;fontColor=#000000;fontSize=12;fillColor=#FFFFE0;strokeColor=#BDBD00;rounded=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="190" y="960" width="700" height="130" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;UML legend&lt;/b&gt;&lt;br&gt;Stick figure = actor · Oval = use case · «component» = deployable part&lt;br&gt;Cylinder = database · Red dashed = external system (outside our system)&lt;br&gt;Purple dashed = ADDITIONAL — NOT REQUIRED (AI chat)&lt;br&gt;Line without arrow = actor association · «extend» = optional extension" style="whiteSpace=wrap;html=1;fontColor=#000000;fontSize=12;fillColor=#FFFFE0;strokeColor=#BDBD00;rounded=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="920" y="960" width="540" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
