# Copy to .env (never commit .env). Real environment variables override .env.
# --- Shared ---
# Leave DATABASE_URL empty to run the API without a database (healthz = degraded).
DATABASE_URL=postgres://dwts:dwts@localhost:5432/dwts?sslmode=disable
LOG_LEVEL=info
LOG_FORMAT=text
MIN_YEAR=1900
# Stories manifest + media. Dev placeholders (Ahmed's side): STORIES_DIR=testdata/stories
STORIES_DIR=./data/stories

# --- API (Ahmed) ---
HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
REQUEST_TIMEOUT=10s
DB_MAX_CONNS=10
CUBE_RELOAD_INTERVAL=60s
STATIC_DIR=
# DEV-ONLY (until A2): serve E2–E5 from a JSON fixture instead of the DB
STATS_FIXTURE=
# DEV-ONLY (until A2): incidents for the SAR drill-down (E10) without a DB
INCIDENTS_FIXTURE=
ASF_BASE_URL=https://api.daac.asf.alaska.edu/services/search/param
ASF_TIMEOUT=8s
# ALOS PALSAR processingLevel for /sar (L1.5 verified live 2026-11-15; L1.0 and RTC_HI_RES also return scenes)
ASF_ALOS_LEVEL=L1.5
SAR_WINDOW_DAYS=45
SAR_CACHE_TTL=24h
SAR_DB_FRESH=168h

# --- AI chat (ADDITIONAL — NOT REQUIRED; off by default) ---
CHAT_ENABLED=false
LLM_PROVIDERS=groq,gemini,openrouter
CHAT_RATE_PER_MIN=10
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# --- Ingest (Mohammed, M1) ---
RAW_DIR=./data/raw
BOUNDARIES_PATH=./data/boundaries/ne_50m_admin_0_countries.geojson
USGS_MIN_MAG=4.5
INGEST_WORKERS=4
FIRMS_MAP_KEY=
FIRMS_PRODUCT=MODIS_SP
